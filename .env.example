PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/frutlle
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=30d
ADMIN_EMAIL=admin@frutllejam@gmail.com
ADMIN_PASSWORD=your_admin_password_here
PAYMENT_SECRET=your_payment_secret
EMAIL_USER=your_email
EMAIL_PASSWORD=your_email_password
FRONTEND_URL=http://localhost:5173
# Backend API Base URL (leave empty for local Vite proxy; production uses .env.production)
VITE_API_URL=

# Supabase (Frontend Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Backend Express)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

